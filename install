#!/usr/bin/env bash

set -e

# Exporting the specific shell we want to work with:

SHELL='/bin/bash'
export SHELL

BASEDIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"

cd "$BASEDIR"

# Ensure submodules (e.g. dotbot, nvim plugins) are present.
git submodule sync --quiet --recursive 2>/dev/null || true
git submodule update --init --recursive 2>/dev/null || true

# Thin entrypoint: delegate to the shared bootstrap.
./dependencies/bootstrap.sh "$@"
