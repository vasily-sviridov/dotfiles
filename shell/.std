#!/usr/bin/env zsh

# `.std` provides customization for standard features.

is_wsl() {
    grep -qi microsoft /proc/version 2>/dev/null
}

is_ubuntu() {
    [[ -f /etc/os-release ]] &&
        grep -qi '^ID=ubuntu$' /etc/os-release &&
        ! is_wsl
}

is_macos() {
    [[ "$(uname -s)" == "Darwin" ]]
}

# === Colorize stderr ===
# Taken from https://github.com/fniessen/shell-leuven


_color_stderr_bold() {
  # Sysread & syswrite are part of `zsh/system'.
  emulate -LR zsh
  local stderr_bold_esc_code=$'\e[1;30m'
  while sysread; do
    syswrite -o 2 "${stderr_bold_esc_code}${REPLY}$terminfo[sgr0]"
  done
}

# TODO: uncomment next line to highlight stderr as bold text for debugging
